{
  "name": "seven-day-event-demo",
  "version": "0.4.0",
  "private": true,
  "description": "Local CAMEO news-event research demo with a seven-day reported-action proxy model",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "build-model": "node build-model.mjs",
    "compare-validation": "node scripts/compare-validation-v8.mjs",
    "evaluate-astra": "node scripts/evaluate-astra-recognition.mjs current",
    "prepare-evaluation": "node scripts/prepare-evaluation.mjs",
    "evaluate-recognition": "node scripts/evaluate-recognition.mjs",
    "collect-globalvoices": "node scripts/collect-globalvoices.mjs",
    "collect-voa": "node scripts/collect-voa.mjs",
    "prepare-expansion": "node scripts/prepare-expansion.mjs",
    "prepare-expansion-supplement": "node scripts/prepare-expansion-supplement.mjs",
    "audit-expansion": "node scripts/audit-expansion.mjs",
    "prepare": "node scripts/prepare-development.mjs && node scripts/prepare-input.mjs",
    "predict-test": "node scripts/predict-batch.mjs",
    "prepare-input": "node scripts/prepare-input.mjs",
    "check": "node --check static/app.js"
  }
}
